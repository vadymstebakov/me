{
    "type": "module",
    "engines": {
        "node": ">=26",
        "yarn": "please-use-npm",
        "pnpm": "please-use-npm"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "lint:eslint": "eslint --cache --max-warnings 0 --report-unused-disable-directives \"**/*.{js,ts,mjs,cjs,astro,tsx,jsx}\"",
        "lint:stylelint": "stylelint --cache -q \"**/*.{css,astro}\"",
        "lint:prettier": "prettier --check \"**/*.{js,ts,tsx,jsx,json,astro,html,css,mjs,cjs}\"",
        "lint:prettier:fix": "prettier --write \"**/*.{js,ts,tsx,jsx,json,astro,html,css,mjs,cjs}\"",
        "lint": "astro check && npm run lint:eslint && npm run lint:stylelint && npm run lint:prettier"
    },
    "dependencies": {
        "@astrojs/check": "0.9.12",
        "astro": "7.4.5",
        "typescript": "7.0.2"
    },
    "devDependencies": {
        "@astrojs/ts-plugin": "1.10.12",
        "@typescript-eslint/parser": "8.72.1",
        "autoprefixer": "10.6.2",
        "eslint": "10.14.0",
        "eslint-plugin-astro": "3.2.1",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "postcss-html": "2.0.0",
        "prettier": "3.9.10",
        "prettier-plugin-astro": "1.1.2",
        "stylelint": "18.0.0",
        "stylelint-config-html": "2.0.0",
        "stylelint-config-standard": "41.0.0"
    },
    "overrides": {
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        }
    }
}
