{
    "type": "module",
    "engines": {
        "node": ">=24",
        "yarn": "please-use-npm",
        "pnpm": "please-use-npm"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "lint:eslint": "eslint --cache --max-warnings 0 --report-unused-disable-directives \"**/*.{js,ts,mjs,cjs,astro,tsx,jsx}\"",
        "lint:stylelint": "stylelint --cache -q \"**/*.{css,astro}\"",
        "lint:prettier": "prettier --check \"**/*.{js,ts,tsx,jsx,json,astro,html,css,mjs,cjs}\"",
        "lint:prettier:fix": "prettier --write \"**/*.{js,ts,tsx,jsx,json,astro,html,css,mjs,cjs}\"",
        "lint": "astro check && npm run lint:eslint && npm run lint:stylelint && npm run lint:prettier"
    },
    "dependencies": {
        "@astrojs/check": "0.9.10",
        "astro": "7.3.5",
        "typescript": "6.0.3"
    },
    "devDependencies": {
        "@astrojs/ts-plugin": "1.10.12",
        "@typescript-eslint/parser": "8.71.0",
        "autoprefixer": "10.6.1",
        "eslint": "10.11.0",
        "eslint-plugin-astro": "3.2.1",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "postcss-html": "2.0.0",
        "prettier": "3.9.9",
        "prettier-plugin-astro": "1.1.0",
        "stylelint": "17.16.0",
        "stylelint-config-html": "2.0.0",
        "stylelint-config-standard": "40.0.0"
    }
}
